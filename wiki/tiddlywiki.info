{
  "description": "TW-Plugin-Info-Tree development wiki",
  "plugins": [
    "tiddlywiki/filesystem",
    "tiddlywiki/tiddlyweb",
    "tiddlywiki/katex",
    "nikorion/plugin-info-tree",
    "nikorion/detect-language"
  ],
  "themes": [
    "tiddlywiki/vanilla"
  ],
  "languages": [
    "fr-FR"
  ],
  "pluginPath": "../src",
  "config": {
    "retain-original-tiddler-path": true
  },
  "build": {
    "plugin-json": [
      "--output", "dist",
      "--render", "$:/core/templates/exporters/JsonFile", "TW-Plugin-Info-Tree-Plugin.json", "text/plain", "", "exportFilter", "[[$:/plugins/nikorion/plugin-info-tree]]"
    ],
    "html": [
      "--output", "docs",
      "--rendertiddler", "$:/core/save/all", "TW-Plugin-Info-Tree-Wiki.html", "text/plain", "",
      "publishFilter", "-[[$:/dev/hmr]] -[[$:/config/dev/hmr-port]] -[[$:/config/SyncFilter]] -[[$:/config/FileSystemPaths]] -[[$:/config/OriginalTiddlerPaths]] -[[$:/plugins/wikilabs/link-to-tabs]] -[[$:/plugins/kookma/commander]] -[[$:/plugins/oeyoews/tiddlywiki-codemirror-6]]"
    ]
  }
}
